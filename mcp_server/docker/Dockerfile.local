# syntax=docker/dockerfile:1
# Standalone Graphiti MCP Server image built from LOCAL graphiti-core sources.
#
# Unlike Dockerfile.standalone (which pulls graphiti-core from PyPI), this
# installs graphiti-core from the repo root so in-tree changes — including
# unreleased graphiti_core improvements — ship in the image.
#
# Build context MUST be the repo root (../..), not mcp_server/:
#   docker buildx build -f mcp_server/docker/Dockerfile.local ../..

FROM python:3.11-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ADD https://astral.sh/uv/install.sh /uv-installer.sh
RUN sh /uv-installer.sh && rm /uv-installer.sh

ENV PATH="/root/.local/bin:${PATH}"

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    MCP_SERVER_HOST="0.0.0.0" \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml uv.lock README.md LICENSE py.typed ./
COPY graphiti_core ./graphiti_core

WORKDIR /app/mcp

COPY mcp_server/pyproject.toml ./pyproject.toml
COPY mcp_server/uv.lock ./uv.lock

RUN cat >> pyproject.toml <<'EOF'

[tool.uv.sources]
graphiti-core = { path = "/app", editable = false }
EOF

RUN rm -f uv.lock && uv lock

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --no-group dev

COPY mcp_server/main.py ./
COPY mcp_server/src ./src
COPY mcp_server/config ./config

RUN mkdir -p /var/log/graphiti

ARG MCP_SERVER_VERSION=1.0.2
ARG BUILD_DATE
ARG VCS_REF
LABEL org.opencontainers.image.title="Graphiti MCP Server (Bearer Auth, Local Build)" \
      org.opencontainers.image.description="Graphiti MCP server with Bearer token auth + DNS rebinding fix, built from local graphiti-core sources" \
      org.opencontainers.image.version="${MCP_SERVER_VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.source="https://github.com/brentkearney/graphiti"

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uv", "run", "--no-sync", "main.py"]
